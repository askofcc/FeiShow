{
  "name": "feishu-next",
  "version": "4.10.4",
  "packageManager": "yarn@1.22.22",
  "homepage": "https://github.com/askofcc/FeishuNext",
  "license": "MIT",
  "engines": {
    "node": ">=20 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/askofcc/FeishuNext.git"
  },
  "author": {
    "name": "FeishuNext",
    "url": "https://feishunext.srint.cn/"
  },
  "scripts": {
    "dev": "next dev",
    "build": "cross-env BUILD_MODE=true next build",
    "start": "next start",
    "post-build": "next-sitemap --config next-sitemap.config.js",
    "export": "cross-env BUILD_MODE=true EXPORT=true next build && next-sitemap --config next-sitemap.config.js",
    "bundle-report": "cross-env ANALYZE=true next build",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:install": "yarn install --frozen-lockfile",
    "deps:check-lockfile": "yarn install --frozen-lockfile && git diff --exit-code yarn.lock",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "verify:agent": "node scripts/verify-agent-api.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@clerk/localizations": "^3.37.6",
    "@clerk/nextjs": "^5.7.6",
    "@headlessui/react": "^1.7.19",
    "@next/bundle-analyzer": "^12.3.7",
    "@supabase/supabase-js": "^2.107.0",
    "@tabler/icons-react": "^3.36.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/functions": "^3.6.2",
    "algoliasearch": "^4.25.2",
    "axios": "^1.17.0",
    "critters": "^0.0.23",
    "feed": "^4.2.2",
    "gsap": "^3.15.0",
    "ioredis": "^5.11.1",
    "js-md5": "^0.8.3",
    "js-sha256": "^0.11.1",
    "memory-cache": "^0.2.0",
    "next": "^14.2.30",
    "notion-client": "7.10.0",
    "notion-utils": "7.10.0",
    "p-limit": "^7.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-facebook": "^8.1.4",
    "react-hotkeys-hook": "^4.6.2",
    "react-notion-x": "7.10.0",
    "react-tweet-embed": "~2.0.0",
    "remixicon-react": "^1.0.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@netlify/plugin-nextjs": "^5.15.11",
    "@notionhq/client": "^2.2.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "22.19.19",
    "@types/react": "18.3.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@waline/client": "^3.13.0",
    "autoprefixer": "^10.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^13.5.11",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "next-sitemap": "^1.9.12",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "webpack-bundle-analyzer": "^4.5.0"
  },
  "resolutions": {
    "axios": ">=0.21.1",
    "esbuild": "^0.25.0",
    "flatted": "^3.4.2",
    "form-data": "^4.0.4",
    "js-cookie": "^3.0.7",
    "lodash": "^4.18.1",
    "picomatch": "^2.3.2",
    "qs": "^6.15.2",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1"
  },
  "bugs": {
    "url": "https://github.com/askofcc/FeishuNext/issues"
  },
  "description": "FeishuNext — publish Feishu docs and bitable as a public site"
}
