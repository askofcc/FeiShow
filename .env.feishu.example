REVALIDATION_TOKEN=

# Main wiki/docx used as site default banner when HOME_BANNER_IMAGE is not enabled
# FEISHU_SITE_ROOT=https://xxx.feishu.cn/wiki/TOKEN
# (falls back to FEISHU_LIST_ROOT / FEISHU_ROOT_DOCUMENT_ID)

# Post path prefix (NotionNext default). Omit or set to article → /article/{token}
# NEXT_PUBLIC_POST_URL_PREFIX=article
# Set to empty only if you want bare /{token}
# NEXT_PUBLIC_POST_URL_PREFIX=

# Content table view id (Grid order = UI order when no 排序 field)
# FEISHU_CONTENT_VIEW_ID=vewONs3mNZ
# Content-table menus (菜单/子菜单). Default off; turn on via CONFIG-TABLE 启用 or:
# NEXT_PUBLIC_CUSTOM_MENU=true
