# Minimal Vercel / runtime bootstrap (FeiShow)
# CMS defaults to feishu — no need to set CMS_PROVIDER unless overriding.

# --- Required (Only 3 variables) ---
# Feishu App ID & Secret
# Option A (Public test credentials for instant setup):
FEISHU_APP_ID=cli_aa0f2dc1f8f81beb
FEISHU_APP_SECRET=raTlSQRuA0Sr8oTRt5VJxe7X1vDkVZSg
# Option B (Production): Quick create your own app -> https://open.feishu.cn/page/launcher?from=backend_oneclick

# Main wiki/doc root (Clone official template: https://test-d2al261ggga5.feishu.cn/wiki/AHHowAmX9itAKWkHvWOcqQOPneg)
FEISHU_SITE_ROOT=https://xxx.feishu.cn/wiki/TOKEN

# --- Optional overrides (prefer CONFIG-TABLE / site-root discovery) ---
# FEISHU_DOMAIN=https://open.feishu.cn
# Content / CONFIG tables: leave empty to auto-discover under FEISHU_SITE_ROOT
# FEISHU_CONTENT_APP_TOKEN=
# FEISHU_CONTENT_TABLE_ID=
# FEISHU_CONFIG_APP_TOKEN=
# FEISHU_CONFIG_TABLE_ID=
# FEISHU_CONTENT_VIEW_ID=

# Site brand / cache: put TITLE, LINK, NEXT_REVALIDATE_SECOND etc. in CONFIG-TABLE
# Do NOT set ENABLE_CACHE=false on Vercel.
# NEXT_PUBLIC_REVALIDATE_SECOND is optional; default 300; CONFIG-TABLE wins at runtime.

# Local only:
# ENABLE_CACHE=false
# NEXT_PUBLIC_LINK=http://localhost:3460
# THEME / LANG / AUTHOR / TITLE → CONFIG-TABLE, not env.
